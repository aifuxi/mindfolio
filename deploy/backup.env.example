# 仅作为样例；真实文件保存到 /srv/mindfolio/config/backup.env，权限为 0600。
# Bucket 必须与业务媒体 Bucket 分离，保持私有并启用服务端版本保护。
# 示例地域为 cn-hangzhou；实际值须与创建 Bucket 时选择的地域一致。
RESTIC_REPOSITORY=s3:https://s3.oss-cn-hangzhou.aliyuncs.com/REPLACE_WITH_PRIVATE_BUCKET/restic
RESTIC_PASSWORD_FILE=/srv/mindfolio/config/restic-password
AWS_ACCESS_KEY_ID=REPLACE_WITH_BACKUP_ONLY_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_BACKUP_ONLY_KEY_SECRET
AWS_DEFAULT_REGION=cn-hangzhou
DEPLOY_ENV_FILE=/srv/mindfolio/config/production.env
EDGE_CADDY_DIR=/srv/mindfolio/edge/caddy
