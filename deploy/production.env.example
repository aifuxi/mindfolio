# 将本文件另存到 /srv/mindfolio/config/production.env，权限设为 0600。
# 镜像引用从通过检查的 GitHub Actions 发布摘要复制，不使用可变标签。
API_IMAGE=ghcr.io/aifuxi/mindfolio-api@sha256:REPLACE_WITH_PUBLISHED_DIGEST
ADMIN_IMAGE=ghcr.io/aifuxi/mindfolio-admin@sha256:REPLACE_WITH_PUBLISHED_DIGEST
EDGE_IMAGE=ghcr.io/aifuxi/mindfolio-edge@sha256:REPLACE_WITH_PUBLISHED_DIGEST

# ADMIN_DOMAIN 和 PORTAINER_DOMAIN 只填写域名；两个 ORIGIN 必须包含协议并与浏览器来源一致。
ADMIN_DOMAIN=admin.example.com
PORTAINER_DOMAIN=portainer.fuxiaochen.com
PORTAINER_ORIGIN=https://portainer.fuxiaochen.com
AUTH_ORIGIN=https://admin.example.com
EDGE_CADDY_DIR=/srv/mindfolio/edge/caddy

# 为 AliDNS DNS challenge 建立只允许必要 DNS 操作的独立 RAM 凭据。
ALIYUN_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY_ID
ALIYUN_ACCESS_KEY_SECRET=REPLACE_WITH_ACCESS_KEY_SECRET

# DATABASE_URL 中的密码需按 URL 规则编码，并与 POSTGRES_PASSWORD 相同。
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DATABASE_URL=postgres://mindfolio:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/mindfolio
