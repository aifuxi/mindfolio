[Unit]
Description=保存 Mindfolio Portainer 与 Caddy 状态
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/srv/mindfolio/repo
EnvironmentFile=/srv/mindfolio/config/backup.env
Environment=BACKUP_TMP_DIR=/run/mindfolio-backup
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/root/.local/bin
RuntimeDirectory=mindfolio-backup
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/env mise run backup:state
UMask=0077
