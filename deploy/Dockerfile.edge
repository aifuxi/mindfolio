# syntax=docker/dockerfile:1.7

FROM caddy:2.10.2-builder-alpine@sha256:4cff3ae272ea05842adb4546e35961e4947aeea65f80fa1eb62a35b960e84971 AS builder
RUN xcaddy build v2.10.2 --with github.com/caddy-dns/alidns@v1.0.29 --output /usr/bin/caddy

FROM caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
ARG VCS_REF=unknown
ARG IMAGE_VERSION=unknown
LABEL org.opencontainers.image.source="https://github.com/aifuxi/mindfolio" \
      org.opencontainers.image.revision="$VCS_REF" \
      org.opencontainers.image.version="$IMAGE_VERSION"
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 CMD ["caddy", "version"]
